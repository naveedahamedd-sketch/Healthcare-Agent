# Free local open-source LLM support through Ollama.
# Install Ollama, then run: ollama pull deepseek-r1:1.5b
HEALTHCARE_LLM_ENABLED=true
HEALTHCARE_LLM_PROVIDER=ollama
HEALTHCARE_LLM_BASE_URL=http://127.0.0.1:11434
HEALTHCARE_LLM_MODEL=deepseek-r1:1.5b
HEALTHCARE_LLM_TIMEOUT_SECONDS=5
HEALTHCARE_LLM_MAX_CONTEXT_CHARS=12000

# Optional caregiver alert support
ENABLE_REAL_ALERTS=false

# Local data paths
HEALTHCARE_DATA_DIR=data
HEALTHCARE_MEMORY_DIR=.agent_memory
